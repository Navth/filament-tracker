# Copy to agent/.env. Never commit real values.

# Which model runs the agent: gemini (default, free tier works) or claude
FT_AGENT_PROVIDER=gemini

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# FT_GEMINI_MODEL=gemini-flash-latest
# FT_GEMINI_THINKING=low          # minimal | low | medium | high (unset = model default)
# FT_GEMINI_RPM=8                 # requests per minute; keep under your free-tier limit
# FT_JUDGE_MODEL=gemini-flash-lite-latest   # eval judge, a different model from the one under test

# Claude (https://console.anthropic.com), when FT_AGENT_PROVIDER=claude
ANTHROPIC_API_KEY=
# FT_AGENT_MODEL=claude-opus-5-5
# FT_AGENT_EFFORT=medium          # low | medium | high | xhigh | max
# FT_AGENT_FALLBACKS=1            # server-side refusal fallback (Claude API only)

# Same Supabase project as the web app. Only needed for your real data;
# --demo mode and the evals use built-in demo data.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Agent behaviour
# FT_AGENT_MAX_STEPS=8            # model calls per turn before giving up
# FT_AGENT_HISTORY_BUDGET=3000    # tokens of past turns carried into each turn
# FT_AGENT_KEEP_TURNS=4           # recent turns kept verbatim; older ones get summarised

# HTTP API (ft-agent serve)
# ALLOWED_EMAILS=you@example.com  # same allowlist as the web app; empty = anyone signed in
# FT_AGENT_DATABASE_URL=postgresql://...   # Postgres checkpoints (needed on Cloud Run); default is SQLite
# FT_AGENT_DB_SCHEMA=agent        # schema for the checkpoint tables
# FT_AGENT_DB=~/.filament-agent/server-threads.sqlite   # SQLite path when no database URL is set
