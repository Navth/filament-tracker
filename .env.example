# Copy to .env.local for local development. Never commit real values.

# Supabase project (Project Settings -> API). The publishable key is safe to
# share; the app only uses it from the server, with the user's session.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 32 random bytes, base64. Encrypts Bambu tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it means every user has to reconnect Bambu Cloud.
TOKEN_ENC_KEY=

# Optional: comma-separated emails allowed to sign in. Empty = anyone.
ALLOWED_EMAILS=

# Optional: public URL of the app, used in sign-up confirmation emails.
# Defaults to the request's host.
SITE_URL=
